{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python plugins/neodev-rd-knowledge/validate_mvp_docs.py prd prototype tech-design"
          }
        ]
      },
      {
        "matcher": "Bash(git push *)",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"After push, run python neodev.py git post-push-refresh --project-id <project_id> --branch <branch> --commit-sha <commit_sha> --json\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash(git commit *)",
        "hooks": [
          {
            "type": "command",
            "command": "python plugins/neodev-rd-knowledge/check_docchange_trailer.py --message-file .git/COMMIT_EDITMSG"
          }
        ]
      },
      {
        "matcher": "Bash(python neodev.py doc scan*)",
        "hooks": [
          {
            "type": "command",
            "command": "python plugins/neodev-rd-knowledge/validate_mvp_docs.py prd prototype tech-design # before python neodev.py doc scan"
          }
        ]
      }
    ]
  }
}
