{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python plugins/neodev-rd-knowledge/validate_mvp_docs.py prd prototype tech-design"
          }
        ]
      },
      {
        "matcher": "Bash(git push *)",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"After push, run neodev project refresh-graph --project-id <project_id> --branch <branch> --json\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash(neodev *|git commit *|git push *)",
        "hooks": [
          {
            "type": "command",
            "command": "python plugins/neodev-rd-knowledge/check_neodev_environment.py"
          }
        ]
      },
      {
        "matcher": "Bash(git commit *)",
        "hooks": [
          {
            "type": "command",
            "command": "python plugins/neodev-rd-knowledge/check_docchange_trailer.py --message-file .git/COMMIT_EDITMSG"
          }
        ]
      },
      {
        "matcher": "Bash(neodev doc scan*)",
        "hooks": [
          {
            "type": "command",
            "command": "python plugins/neodev-rd-knowledge/validate_mvp_docs.py prd prototype tech-design # before neodev doc scan"
          }
        ]
      }
    ]
  }
}
