{
  "version": "0.1.0",
  "mvp_doc_contract": {
    "required_fields": [
      "aliases",
      "created",
      "doc_id",
      "title",
      "doc_type",
      "product_key",
      "related",
      "status",
      "tags",
      "updated",
      "relations"
    ],
    "doc_type": [
      "prd",
      "prototype",
      "tech-design"
    ],
    "status": [
      "draft",
      "active",
      "deprecated"
    ],
    "relations_target": "relations.target must be a non-empty list of real doc_id values that exist in the same docs root",
    "obsidian_properties": "aliases/tags/related must be non-empty lists, created/updated must use YYYY-MM-DD, related must use Obsidian wiki links to real files, and NeoDev workflow docs must use neosuperpower paths/tags"
  },
  "neosuperpower": {
    "requirements_or_design": "neosuperpower:requirements-or-design",
    "implementation": "neosuperpower:implementation",
    "failure_investigation": "neosuperpower:failure-investigation",
    "completion_commit_push": "neosuperpower:verification-before-completion"
  },
  "contract": "NeoDev CLI 是本地客户端调用统一远程服务的唯一执行边界和状态变更边界。插件与内置 skill 只负责引导命令顺序、参数补全、风险提示和结果解释；事实读取与状态写入都必须通过已配置远程服务的 neodev 命令完成。",
  "workflows": {
    "session_version_check": {
      "goal": "在高风险或会写状态的工作流前检查本地 CLI 远程配置和版本兼容性。",
      "steps": [
        {
          "id": "check_remote_config",
          "type": "cli",
          "command": "neodev config show",
          "expects": [
            "data.server_url"
          ]
        },
        {
          "id": "check_cli_contract",
          "type": "cli",
          "command": "neodev cli version-check --json",
          "expects": [
            "data.compatible=true"
          ]
        }
      ]
    },
    "doc_change_to_implementation": {
      "goal": "登记受控文档变更，并收集实现所需上下文。",
      "steps": [
        {
          "id": "check_remote_config",
          "type": "cli",
          "command": "neodev config show",
          "expects": [
            "data.server_url"
          ]
        },
        {
          "id": "check_cli_contract",
          "type": "cli",
          "command": "neodev cli version-check --json"
        },
        {
          "id": "validate_mvp_docs",
          "type": "script",
          "command": "python plugins/neodev-rd-knowledge/validate_mvp_docs.py prd prototype tech-design"
        },
        {
          "id": "validate_obsidian_docs",
          "type": "script",
          "command": "python plugins/neodev-rd-knowledge/validate_obsidian_docs.py docs"
        },
        {
          "id": "scan_controlled_docs",
          "type": "cli",
          "command": "neodev doc scan --doc-binding-id <doc_binding_id> --json"
        },
        {
          "id": "register_doc_change",
          "type": "cli",
          "command": "neodev doc change register --document-id <document_id> --json"
        },
        {
          "id": "estimate_impact",
          "type": "cli",
          "command": "neodev graph impact --doc-change-id <doc_change_id> --json"
        },
        {
          "id": "read_entity_context",
          "type": "cli",
          "command": "neodev graph entity-context --product-code <product_code> --version-name <version_name> --project-id <project_id> --branch <branch> --entity-id <entity_id> --json"
        },
        {
          "id": "read_chain_context",
          "type": "cli",
          "command": "neodev graph get-chain --product-code <product_code> --version-name <version_name> --project-id <project_id> --branch <branch> --start-node <node_id> --json"
        }
      ]
    },
    "repository_auto_graph": {
      "goal": "登记远程仓库地址，并由统一远程 NeoDev 服务自动触发图谱构建。",
      "steps": [
        {
          "id": "check_remote_config",
          "type": "cli",
          "command": "neodev config show",
          "expects": [
            "data.server_url"
          ]
        },
        {
          "id": "check_cli_contract",
          "type": "cli",
          "command": "neodev cli version-check --json"
        },
        {
          "id": "register_repository",
          "type": "cli",
          "command": "neodev project create --name <project_name> --repo-url <repo_url> --json"
        },
        {
          "id": "read_project",
          "type": "cli",
          "command": "neodev project show --project-id <project_id> --json"
        },
        {
          "id": "bind_to_product_version_when_needed",
          "type": "cli",
          "command": "neodev product version bind-branch --product-code <product_code> --version-name <version_name> --project-id <project_id> --branch <branch> --json"
        }
      ]
    },
    "pre_push_verification": {
      "goal": "推送前校验提交只关联一个 DocChange，并处理待确认风险记录。",
      "steps": [
        {
          "id": "check_remote_config",
          "type": "cli",
          "command": "neodev config show",
          "expects": [
            "data.server_url"
          ]
        },
        {
          "id": "check_cli_contract",
          "type": "cli",
          "command": "neodev cli version-check --json"
        },
        {
          "id": "verify_doc_change",
          "type": "cli",
          "command": "neodev git verify-doc-change --project-id <project_id> --branch <branch> --commit-sha <commit_sha> --commit-message <commit_message> --json"
        },
        {
          "id": "list_open_risks",
          "type": "cli",
          "command": "neodev git dangerous-commit list --project-id <project_id> --json"
        },
        {
          "id": "resolve_risk_after_review",
          "type": "cli",
          "command": "neodev git dangerous-commit resolve --record-id <record_id> --resolved-by <user> --json"
        }
      ]
    },
    "project_refresh_graph": {
      "goal": "推送成功后刷新受影响的图谱节点。",
      "steps": [
        {
          "id": "check_remote_config",
          "type": "cli",
          "command": "neodev config show",
          "expects": [
            "data.server_url"
          ]
        },
        {
          "id": "check_cli_contract",
          "type": "cli",
          "command": "neodev cli version-check --json"
        },
        {
          "id": "refresh_branch_graph",
          "type": "cli",
          "command": "neodev project refresh-graph --project-id <project_id> --branch <branch> --json"
        },
        {
          "id": "inspect_chain_when_needed",
          "type": "cli",
          "command": "neodev graph get-chain --product-code <product_code> --version-name <version_name> --project-id <project_id> --branch <branch> --commit-sha <commit_sha> --json"
        }
      ]
    }
  }
}
